<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp7_B - ICESat-2 menos MDE por zona y por MDE" description="Segmentos ATL08 de 100 m con terreno valido (2018-2026) en E1_DIAMANTE_BARRANCA: diferencia ICESat-2 menos IGN 5 m (SRVN16), GLO-30 y FABDEM (EGM2008), con la zona (ladera, anillo, resto), la fuerza del haz y la pendiente.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - ICESat-2 menos MDE" position="(80, 220)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table" position="(330, 60)" />
		<node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - diferencia por MDE" position="(330, 200)" />
		<node id="3" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - diferencia por zona" position="(330, 340)" />
		<node id="4" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Scatter Plot - pendiente frente a diferencia" position="(330, 480)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="1" source_node_id="0" sink_node_id="2" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
