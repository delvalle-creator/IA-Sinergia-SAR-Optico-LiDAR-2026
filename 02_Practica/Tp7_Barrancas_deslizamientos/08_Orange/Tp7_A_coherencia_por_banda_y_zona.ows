<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp7_A - coherencia de X y C por cobertura y por zona" description="Muestra de pixeles de 10 m (hasta 800 por clase de MapBiomas 2018, semilla 2026) con la coherencia X (COSMO-SkyMed 15-19/10/2018) y C (Sentinel-1 HyP3 12-24/10 y 18-30/09/2018) y la zona (escarpa, bloque, pie, ciudad, anillo).">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - coherencia por pixel" position="(80, 220)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table" position="(330, 60)" />
		<node id="2" name="Distributions" qualified_name="Orange.widgets.visualize.owdistributions.OWDistributions" project_name="Orange3" version="" title="Distributions - coherencia X por cobertura" position="(330, 200)" />
		<node id="3" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - coherencia C (octubre) por cobertura" position="(330, 340)" />
		<node id="4" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - coherencia X por zona" position="(330, 480)" />
		<node id="5" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Scatter Plot - coherencia X frente a C" position="(330, 620)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
