<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp2 E - Cada banda frente a las clases de MapBiomas 2025 y la biomasa del CCI" description="Hasta 3000 pixeles por clase de MapBiomas Argentina 2025 en A2_IBICUY, con gamma0 en dB de C (Sentinel-1 26/09), S y L (NISAR 30/09) y P (BIOMASS 05/10), la AGB 2024 del CCI Biomass y la altura FH de BIOMASS L2A.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="Pixeles por clase MapBiomas (File)" position="(80, 300)" />
		<node id="1" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Banda C (5,6 cm), VH por clase" position="(360, 40)" />
		<node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Banda S (9,4 cm), HV por clase" position="(360, 160)" />
		<node id="3" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Banda L (24 cm), HV por clase" position="(360, 280)" />
		<node id="4" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Banda P (69 cm), VH por clase" position="(360, 400)" />
		<node id="5" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Biomasa CCI 2024 frente a cruzada P" position="(360, 520)" />
		<node id="6" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Biomasa CCI 2024 por clase" position="(360, 640)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
