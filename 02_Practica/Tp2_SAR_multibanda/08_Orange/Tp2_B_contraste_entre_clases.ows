<scheme version="2.0" title="Tp2 B - Contraste entre clases" description="A2_IBICUY_contraste_entre_clases.csv: diferencia de medias (dB) entre cada par de clases en cada banda.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="Contrastes (File)" position="(80, 200)" />
		<node id="1" name="Pivot Table" qualified_name="Orange.widgets.data.owpivot.OWPivot" project_name="Orange3" version="" title="Contraste por par y banda" position="(330, 120)" />
		<node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Contraste absoluto por banda" position="(330, 260)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
