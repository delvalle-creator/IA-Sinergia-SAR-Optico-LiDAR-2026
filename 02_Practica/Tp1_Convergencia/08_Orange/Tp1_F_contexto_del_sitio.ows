<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp1 F - Contexto del sitio: MapBiomas, CCI Biomass y banda P" description="B_CONCORDIA: area por clase de MapBiomas 1985-2025 y, para hasta 2000 pixeles por clase de 2025, la biomasa del CCI, la altura FH de BIOMASS y la banda P (HH y VH, en dB).">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="Area por clase y anio (File)" position="(80, 80)" />
