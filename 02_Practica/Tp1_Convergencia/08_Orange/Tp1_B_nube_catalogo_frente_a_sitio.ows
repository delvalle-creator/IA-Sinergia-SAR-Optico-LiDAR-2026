<scheme version="2.0" title="Tp1 B - Nube del catalogo frente a nube del sitio" description="Sentinel-2 sobre B_CONCORDIA, octubre y noviembre de 2023: nubosidad de la tesela frente a la del sitio.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="Nubosidad Sentinel-2 (File)" position="(80, 200)" />
