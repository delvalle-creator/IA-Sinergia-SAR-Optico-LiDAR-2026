<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp10_A - qué ve cada banda en cada clase del entrenamiento" description="300 píxeles de 20 m por clase del entrenamiento de MapBiomas (píxeles estables 2023-2025), con C VV y VH del compuesto de Sentinel-1, S HH de NovaSAR, L HH y HV de NISAR en dB, y NDBI, NDVI y MNDWI del compuesto de Sentinel-2.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - píxeles del entrenamiento" position="(80, 260)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table" position="(330, 40)" />
		<node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - C VV por clase" position="(330, 160)" />
		<node id="3" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - S HH por clase" position="(330, 280)" />
		<node id="4" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - L HH por clase" position="(330, 400)" />
		<node id="5" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Scatter Plot - C VV frente a L HH" position="(330, 520)" />
		<node id="6" name="Rank" qualified_name="Orange.widgets.data.owrank.OWRank" project_name="Orange3" version="" title="Rank - ganancia de información por capa" position="(330, 640)" />
		<node id="7" name="Random Forest" qualified_name="Orange.widgets.model.owrandomforest.OWRandomForest" project_name="Orange3" version="" title="Random Forest (300 árboles)" position="(330, 760)" />
		<node id="8" name="Test and Score" qualified_name="Orange.widgets.evaluate.owtestandscore.OWTestAndScore" project_name="Orange3" version="" title="Test and Score - validación cruzada con píxeles de entrenamiento (OPTIMISTA)" position="(560, 700)" />
	</nodes>
	<links>
