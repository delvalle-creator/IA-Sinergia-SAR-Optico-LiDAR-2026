<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp10_B - variantes validadas e importancia de las capas" description="Tabla de Tp4_04 con las cuatro variantes (óptico solo, C sola, SAR multibanda C + L y multisensor), la fila de la multisensor con S (Tp4_03, solo en la huella de NovaSAR) y la importancia de cada capa del Random Forest multisensor (Tp10_02).">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - tabla de variantes (Tp4_04 y Tp4_03)" position="(80, 120)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table - variantes" position="(330, 40)" />
		<node id="2" name="Bar Plot" qualified_name="Orange.widgets.visualize.owbarplot.OWBarPlot" project_name="Orange3" version="" title="Bar Plot - comisión de la clase urbano" position="(330, 160)" />
		<node id="3" name="Bar Plot" qualified_name="Orange.widgets.visualize.owbarplot.OWBarPlot" project_name="Orange3" version="" title="Bar Plot - porcentaje urbano estimado" position="(330, 280)" />
		<node id="4" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - importancia de las capas (Tp10_02)" position="(80, 440)" />
		<node id="5" name="Bar Plot" qualified_name="Orange.widgets.visualize.owbarplot.OWBarPlot" project_name="Orange3" version="" title="Bar Plot - importancia por capa (multisensor)" position="(330, 440)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="1" source_node_id="0" sink_node_id="2" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
