<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp4 A - Puntos etiquetados a ciegas, unidos a la llave" description="70 puntos del ensayo sobre el mapa de control de B_CONCORDIA: clase del mapa (de la llave), clase de referencia (etiquetada a ciegas sobre Esri y Google), confianza y fuente del pixel en el mapa de control (digitalizado, JRC o MapBiomas).">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="Puntos con la llave (File)" position="(60, 240)" />
		<node id="1" name="Pivot Table" qualified_name="Orange.widgets.data.owpivot.OWPivot" project_name="Orange3" version="" title="Matriz de error en conteos (Pivot Table)" position="(320, 40)" />
		<node id="2" name="Pivot Table" qualified_name="Orange.widgets.data.owpivot.OWPivot" project_name="Orange3" version="" title="Aciertos por fuente del mapa de control" position="(320, 180)" />
		<node id="3" name="Pivot Table" qualified_name="Orange.widgets.data.owpivot.OWPivot" project_name="Orange3" version="" title="Aciertos por confianza" position="(320, 320)" />
		<node id="4" name="Select Rows" qualified_name="Orange.widgets.data.owselectrows.OWSelectRows" project_name="Orange3" version="" title="Solo los puntos que no coinciden" position="(320, 460)" />
		<node id="5" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Los desacuerdos" position="(580, 460)" />
		<node id="6" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Puntos en el sitio (x, y en km, UTM 21S)" position="(320, 600)" />
	</nodes>
