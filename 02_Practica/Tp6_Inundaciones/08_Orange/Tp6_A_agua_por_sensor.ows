<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp6_A - agua segun el radar y el optico" description="Muestra de 10 000 pixeles por grupo (agua permanente, agua de inundacion segun el optico, resto) con VV, VH, VV/VH, MNDWI, JRC, MapBiomas 2023 y duracion.">
  <nodes>
    <node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - 30 000 pixeles de 20 m (04/11/2023)" position="(80, 220)" />
    <node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table" position="(330, 60)" />
    <node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - VV (dB) por grupo" position="(330, 200)" />
    <node id="3" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot - VH (dB) por grupo" position="(330, 340)" />
    <node id="4" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Scatter Plot - VV frente a VH" position="(330, 480)" />
    <node id="5" name="Select Columns" qualified_name="Orange.widgets.data.owselectcolumns.OWSelectAttributes" project_name="Orange3" version="" title="Select Columns - VV, VH y VV/VH; grupo como clase" position="(560, 620)" />
    <node id="6" name="Rank" qualified_name="Orange.widgets.data.owrank.OWRank" project_name="Orange3" version="" title="Rank - que polarizacion separa mejor los grupos" position="(800, 560)" />
    <node id="7" name="Tree" qualified_name="Orange.widgets.model.owtree.OWTreeLearner" project_name="Orange3" version="" title="Tree - profundidad 2" position="(800, 700)" />
    <node id="8" name="Tree Viewer" qualified_name="Orange.widgets.visualize.owtreeviewer.OWTreeGraph" project_name="Orange3" version="" title="Tree Viewer - los cortes que elige el arbol" position="(1040, 700)" />
  </nodes>
