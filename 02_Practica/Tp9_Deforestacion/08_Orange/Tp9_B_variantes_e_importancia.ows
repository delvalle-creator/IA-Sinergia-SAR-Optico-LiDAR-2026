<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Tp9_B - variantes validadas e importancia de los rasgos" description="Tabla de Tp4_04 con las tres variantes (solo optico, solo banda L, multisensor) y la importancia de cada rasgo del Random Forest (Tp9_03).">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - tabla de variantes (Tp4_04)" position="(80, 120)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table - variantes" position="(330, 40)" />
		<node id="3" name="Bar Plot" qualified_name="Orange.widgets.visualize.owbarplot.OWBarPlot" project_name="Orange3" version="" title="Bar Plot - porcentaje estimado del sitio" position="(330, 280)" />
		<node id="4" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File - importancia de los rasgos (Tp9_03)" position="(80, 440)" />
		<node id="5" name="Bar Plot" qualified_name="Orange.widgets.visualize.owbarplot.OWBarPlot" project_name="Orange3" version="" title="Bar Plot - importancia por rasgo" position="(330, 440)" />
		<node id="6" name="Scatter Plot" qualified_name="Orange.widgets.visualize.owscatterplot.OWScatterPlot" project_name="Orange3" version="" title="Scatter Plot - comision e IC_comision por variante" position="(330, 160)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
